<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vorbereitung: Freies Sprechen mit Sprechkarten · deutschoderwas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1a1a1a; --muted:#6f6a62; --cream:#fdf8f1; --card:#ffffff;
    --red:#dd0000; --gold:#ffce00; --teal:#35AFD0; --teal-dark:#138a8a;
    --teal-soft:#E6F8FC; --gold-soft:#fff6da; --line:#ece5d8; --green:#127a44;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{font-family:'Inter',system-ui,sans-serif; color:var(--ink); background:var(--cream); line-height:1.55; padding-bottom:48px; -webkit-font-smoothing:antialiased;}
  h1,h2,h3,.brand-name{font-family:'Space Grotesk','Inter',sans-serif;}
  header{background:#fff; border-bottom:1px solid var(--line); padding:0 22px 20px;}
  .accent-bar{height:5px; margin:0 -22px 18px; background:linear-gradient(135deg,var(--red),var(--gold));}
  .brand{display:flex; align-items:center; gap:11px; padding-top:16px;}
  .logo-dot{width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg,var(--red),var(--gold)); flex:none;}
  .brand-name{font-weight:700; font-size:1.05rem; letter-spacing:-.3px;}
  .brand-tag{font-size:.72rem; color:var(--muted);}
  .back{margin-left:auto; font-size:.8rem; font-weight:700; color:var(--teal-dark); text-decoration:none; border:1.5px solid var(--line); padding:6px 12px; border-radius:50px;}
  .handout-title{font-weight:700; font-size:1.5rem; margin-top:18px; letter-spacing:-.5px; line-height:1.15;}
  .handout-sub{color:var(--muted); font-size:.86rem; margin-top:5px; font-weight:500;}
  nav{position:sticky; top:0; z-index:50; display:flex; gap:8px; overflow-x:auto; padding:12px 16px; background:rgba(253,248,241,.92); backdrop-filter:blur(8px); border-bottom:1px solid var(--line); scrollbar-width:none;}
  nav::-webkit-scrollbar{display:none;}
  nav button{flex:none; font-family:inherit; font-weight:700; font-size:.8rem; color:var(--ink); background:#fff; border:1.5px solid var(--line); padding:8px 15px; border-radius:50px; cursor:pointer; white-space:nowrap; transition:.12s;}
  nav button:hover{border-color:var(--red);}
  nav button.active{background:var(--red); border-color:var(--red); color:#fff;}
  .tab-content{display:none; max-width:720px; margin:0 auto; padding:22px 16px;}
  .tab-content.active{display:block;}
  .card{background:var(--card); border:1px solid var(--line); border-radius:18px; padding:18px 20px; margin-bottom:16px; box-shadow:0 6px 20px rgba(50,35,10,.05);}
  .card h2{font-size:1.12rem; font-weight:700; letter-spacing:-.3px; margin-bottom:12px; display:flex; gap:9px; align-items:center;}
  .card p{font-size:.94rem;}
  .card.a-red{border-left:5px solid var(--red);}
  .card.a-teal{border-left:5px solid var(--teal);}
  .card.a-gold{border-left:5px solid var(--gold);}
  .satz-list{list-style:none;}
  .satz-list li{background:#faf6ef; border:1px solid var(--line); border-left:4px solid var(--teal); border-radius:10px; padding:11px 13px; margin-bottom:9px; font-size:.92rem;}
  .satz-list li strong{color:var(--teal-dark);}
  strong{font-weight:700;}
  .box{border-radius:14px; padding:14px 16px; margin-bottom:10px; border:1px solid var(--line);}
  .box.mint{background:var(--teal-soft); border-color:#cdeae5;}
  .box.sun{background:var(--gold-soft); border-color:#f3e4b0;}
  .box .box-label{font-size:.73rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--teal-dark); margin-bottom:6px;}
  .box.sun .box-label{color:#a9750a;}
  .box p{font-size:.9rem;}
  details{background:#fff; border:1px solid var(--line); border-left:4px solid var(--teal); border-radius:12px; padding:13px 15px; margin-bottom:10px; cursor:pointer;}
  details summary{font-weight:700; font-size:.92rem; list-style:none; display:flex; justify-content:space-between; gap:12px; align-items:center;}
  details summary::after{content:"Redemittel zeigen"; font-size:.72rem; font-weight:700; color:#fff; background:var(--teal); padding:3px 11px; border-radius:50px; white-space:nowrap;}
  details[open] summary::after{content:"zu"; background:var(--muted);}
  details .answer{margin-top:11px; padding-top:11px; border-top:1px dashed var(--line); font-size:.95rem; line-height:1.7;}
  .exercise{margin-bottom:20px;}
  .exercise p{font-weight:700; font-size:.92rem; margin-bottom:8px;}
  select{font-family:'Inter',sans-serif; font-size:.9rem; padding:6px 9px; border:1.5px solid #d8d2c6; border-radius:9px; background:#fff; color:var(--ink); font-weight:600; cursor:pointer;}
  select.correct{border-color:var(--green); background:#eafaf1;}
  select.wrong{border-color:var(--red); background:#fdeaea;}
  .hl{background:linear-gradient(180deg,transparent 58%,#ffe38a 58%); padding:0 2px; font-weight:700;}
  .handout-title .hl{background:var(--gold); padding:2px 12px; border-radius:9px; -webkit-box-decoration-break:clone; box-decoration-break:clone;}
  .kern{background:linear-gradient(135deg,#fff,#fffaf0); border:1.6px solid var(--gold); border-radius:18px; padding:18px 20px; margin-bottom:16px; box-shadow:0 6px 20px rgba(255,206,0,.10);}
  .kern p{font-size:.96rem;}
  .kern h2{font-family:'Space Grotesk',sans-serif; font-size:1.12rem; font-weight:700; margin-bottom:10px; display:flex; gap:9px; align-items:center;}
  .gapline{display:flex; flex-wrap:wrap; align-items:center; gap:8px;}
  .gapline input{font-family:'Inter',sans-serif; font-size:.95rem; padding:7px 10px; border:1.5px solid #d8d2c6; border-radius:9px; width:180px; font-weight:700; color:var(--ink);}
  .gapline input.correct{border-color:var(--green); background:#eafaf1;}
  .gapline input.wrong{border-color:var(--red); background:#fdeaea;}
  .ex-hint{font-size:.8rem; color:var(--muted); font-weight:700;}
  .ex-intro{font-size:.86rem; color:var(--muted); margin-bottom:14px;}
  .notefield{width:100%; min-height:70px; resize:vertical; font-family:'Inter',sans-serif; font-size:.95rem; color:var(--ink); background:#faf6ef; border:1.5px dashed #d8d2c6; border-radius:12px; padding:10px 12px; line-height:1.55; margin-top:6px;}
  .notefield:focus{outline:none; border-style:solid; border-color:var(--teal); background:#fff;}
</style>
</head>
<body data-speicher="dow-vorb-sprechkarten">

<header>
  <div class="accent-bar"></div>
  <div class="brand">
    <div class="logo-dot"></div>
    <div><div class="brand-name">deutschoderwas</div><div class="brand-tag">Deutsch lernen mit Spaß</div></div>
    <a class="back" href="konto.html#stunden">← Meine Stunden</a>
  </div>
  <h1 class="handout-title">Vorbereitung: <span class="hl">Freies Sprechen mit Sprechkarten</span></h1>
  <p class="handout-sub">A2–C1 · So bleibst du im Gespräch · ca. 10 Minuten vor der Stunde</p>
</header>

<nav>
  <button class="active" onclick="switchTab(0)">🃏 So läuft's</button>
  <button onclick="switchTab(1)">💬 Antworten</button>
  <button onclick="switchTab(2)">🔑 Am Reden bleiben</button>
  <button onclick="switchTab(3)">❓ Nachfragen</button>
  <button onclick="switchTab(4)">✏️ Übungen</button>
  <button onclick="switchTab(5)">📝 Vorbereiten</button>
</nav>

<div class="tab-content active" id="tab0">
  <div class="kern">
    <h2>⭐ Darum geht es</h2>
    <p>In dieser Stunde ziehst du <span class="hl">Sprechkarten</span> und redest einfach los – spontan, in deiner Gruppe. Du brauchst keine perfekten Sätze. Wichtig ist nur: <strong>anfangen, im Gespräch bleiben, aufeinander eingehen.</strong> Diese Vorbereitung gibt dir die Redemittel dafür.</p>
  </div>
  <div class="card a-teal">
    <h2>🃏 So funktioniert's</h2>
    <ul class="satz-list">
      <li><strong>1.</strong> Jemand nennt eine Zahl – die Karte wird umgedreht.</li>
      <li><strong>2.</strong> Die Frage erscheint groß. Darunter stehen oft <strong>Wörter, die helfen</strong>.</li>
      <li><strong>3.</strong> Du antwortest frei – ruhig in mehreren Sätzen. Danach ist die nächste Person dran.</li>
    </ul>
    <div class="box sun"><div class="box-label">Kein Stress</div><p>Pausen sind erlaubt. Niemand muss perfekt reden – Hauptsache, du sprichst und bleibst dabei.</p></div>
  </div>
</div>

<div class="tab-content" id="tab1">
  <div class="card a-teal">
    <h2>💬 Wie antworte ich? – tipp auf einen Button</h2>
    <p class="ex-intro">Je nach Frage brauchst du andere Redemittel. Tippe auf die passende Situation – dann erscheinen die Sätze, mit denen du antworten kannst.</p>

    <details><summary>🙋 Eine Frage über mich („Was machst du gern?")</summary>
      <div class="answer">„Also, am liebsten …" · „Bei mir ist das so: …" · „Ich bin eher jemand, der …" · „Ehrlich gesagt …" · „Das kommt darauf an, aber meistens …"</div></details>

    <details><summary>👍 Zustimmen / etwas gut finden</summary>
      <div class="answer">„Das sehe ich genauso." · „Da stimme ich dir zu." · „Genau, das finde ich auch." · „Das ist ein guter Punkt." · „Das kenne ich auch!"</div></details>

    <details><summary>🤔 Anderer Meinung sein (höflich)</summary>
      <div class="answer">„Da bin ich anderer Meinung." · „Das sehe ich ein bisschen anders." · „Ich verstehe, was du meinst, aber …" · „Stimmt schon, trotzdem …" · „Kann sein, ich würde eher sagen …"</div></details>

    <details><summary>💭 Meine Meinung sagen & begründen</summary>
      <div class="answer">„Ich finde / ich glaube, dass …" · „Meiner Meinung nach …" · „Für mich ist wichtig, dass …" · „… , weil …" · „… , deshalb …" · „Ein Beispiel dafür ist …"</div></details>

    <details><summary>😅 Ich weiß die Antwort nicht genau</summary>
      <div class="answer">„Gute Frage – da muss ich kurz überlegen." · „Hmm, dazu habe ich keine feste Meinung." · „Ich bin mir nicht sicher, aber vielleicht …" · „Das habe ich so noch nie gemacht."</div></details>

    <details><summary>⏮️ Von früher / einem Erlebnis erzählen</summary>
      <div class="answer">„Das erinnert mich an …" · „Einmal ist mir passiert, dass …" · „Als ich … war, …" · „Ich weiß noch, wie …" · „Vor ein paar Jahren habe ich …"</div></details>
  </div>
</div>

<div class="tab-content" id="tab2">
  <div class="card a-teal">
    <h2>🔑 Am Reden bleiben & Zeit gewinnen</h2>
    <p class="ex-intro">Wenn dir kurz nichts einfällt – nicht still werden, sondern diese Sätze benutzen. So bleibst du im Fluss.</p>
    <ul class="satz-list">
      <li><strong>Zeit gewinnen:</strong> „Wie soll ich sagen …" · „Also, lass mich kurz überlegen …" · „Das ist eine interessante Frage …"</li>
      <li><strong>Weiter ausholen:</strong> „Zum Beispiel …" · „Und noch etwas: …" · „Das Gleiche gilt für …"</li>
      <li><strong>Vergleichen:</strong> „Einerseits … andererseits …" · „Im Vergleich dazu …" · „Früher … heute …"</li>
      <li><strong>Ein Wort fehlt:</strong> „Wie heißt das noch mal …" · „So ein Ding, mit dem man …" · „Also so etwas Ähnliches wie …"</li>
    </ul>
    <div class="box mint"><div class="box-label">Trick</div><p>Wiederhol einfach kurz die Frage mit eigenen Worten – so gewinnst du Zeit und findest den Einstieg: „Ob ich gern reise? Ja, also …"</p></div>
  </div>
</div>

<div class="tab-content" id="tab3">
  <div class="card a-teal">
    <h2>❓ Nachfragen & aufeinander eingehen</h2>
    <p class="ex-intro">Sprechkarten machen am meisten Spaß, wenn ihr euch gegenseitig Fragen stellt. Diese Sätze halten das Gespräch am Laufen.</p>
    <ul class="satz-list">
      <li><strong>Zurückfragen:</strong> „Und wie ist das bei dir?" · „Was meinst du dazu?" · „Hast du das auch schon mal erlebt?"</li>
      <li><strong>Mehr wissen wollen:</strong> „Wie meinst du das genau?" · „Warum denn?" · „Erzähl mal mehr!" · „Und dann?"</li>
      <li><strong>Reagieren:</strong> „Echt? Spannend!" · „Das kann ich gut verstehen." · „Oh, das klingt anstrengend." · „Wie schön!"</li>
      <li><strong>Jemanden einbeziehen:</strong> „Was sagst du dazu, …?" · „Du warst doch auch schon mal …, oder?"</li>
    </ul>
  </div>
</div>

<div class="tab-content" id="tab4">
  <div class="card a-teal">
    <h2>✏️ Redemittel vervollständigen</h2>
    <p class="ex-intro">Fünf Lücken – tippe ein passendes Wort und drück „prüfen".</p>
    <div class="exercise"><p>1. „Also, am ___ erzähle ich von meiner Familie." <span class="ex-hint">(anfangen)</span></p>
    <div class="gapline"><input data-answer="liebsten" placeholder="…" onkeydown="if(event.key==='Enter'){checkGap(this.parentElement.querySelector('button'));}"><button onclick="checkGap(this)">prüfen</button></div></div>
    <div class="exercise"><p>2. „Da muss ich kurz ___." <span class="ex-hint">(Zeit gewinnen)</span></p>
    <div class="gapline"><input data-answer="überlegen" placeholder="…" onkeydown="if(event.key==='Enter'){checkGap(this.parentElement.querySelector('button'));}"><button onclick="checkGap(this)">prüfen</button></div></div>
    <div class="exercise"><p>3. „Und wie ist das bei ___?" <span class="ex-hint">(zurückfragen)</span></p>
    <div class="gapline"><input data-answer="dir" placeholder="…" onkeydown="if(event.key==='Enter'){checkGap(this.parentElement.querySelector('button'));}"><button onclick="checkGap(this)">prüfen</button></div></div>
    <div class="exercise"><p>4. „Das sehe ich ein bisschen ___." <span class="ex-hint">(höflich widersprechen)</span></p>
    <div class="gapline"><input data-answer="anders" placeholder="…" onkeydown="if(event.key==='Enter'){checkGap(this.parentElement.querySelector('button'));}"><button onclick="checkGap(this)">prüfen</button></div></div>
    <div class="exercise"><p>5. „Ich finde das gut, ___ es praktisch ist." <span class="ex-hint">(begründen)</span></p>
    <div class="gapline"><input data-answer="weil" placeholder="…" onkeydown="if(event.key==='Enter'){checkGap(this.parentElement.querySelector('button'));}"><button onclick="checkGap(this)">prüfen</button></div></div>
  </div>
  <div class="card a-gold">
    <h2>🎯 Welcher Satz gewinnt Zeit, ohne zu stocken?</h2>
    <div class="exercise"><p>1. Dir fällt kurz nichts ein. Was sagst du?</p>
    <select onchange="checkSelect(this,'Gute Frage, da muss ich kurz überlegen …')">
      <option value="">— wählen —</option><option>Gute Frage, da muss ich kurz überlegen …</option><option>(still bleiben)</option><option>Ich weiß es nicht.</option>
    </select></div>
    <div class="exercise"><p>2. Du willst höflich widersprechen:</p>
    <select onchange="checkSelect(this,'Ich verstehe, was du meinst, aber …')">
      <option value="">— wählen —</option><option>Ich verstehe, was du meinst, aber …</option><option>Das ist falsch.</option><option>Nein.</option>
    </select></div>
    <div class="exercise"><p>3. Du willst die andere Person einbeziehen:</p>
    <select onchange="checkSelect(this,'Und wie ist das bei dir?')">
      <option value="">— wählen —</option><option>Und wie ist das bei dir?</option><option>Ich bin fertig.</option><option>Weiter.</option>
    </select></div>
  </div>
</div>

<div class="tab-content" id="tab5">
  <div class="card a-teal">
    <h2>📝 Deine Startsätze</h2>
    <p class="ex-intro">Notiere dir ein paar Redemittel, die DU in der Stunde benutzen willst. Wird im Browser gespeichert. 💾</p>
    <div class="exercise"><p>1. Mein Satz zum Anfangen:</p>
    <textarea class="notefield" data-save="f1" placeholder="z. B. „Also, bei mir ist das so: …""></textarea></div>
    <div class="exercise"><p>2. Mein Satz, wenn mir nichts einfällt:</p>
    <textarea class="notefield" data-save="f2" placeholder="z. B. „Gute Frage, da muss ich kurz überlegen …""></textarea></div>
    <div class="exercise"><p>3. Meine Rückfrage an die anderen:</p>
    <textarea class="notefield" data-save="f3" placeholder="z. B. „Und wie ist das bei dir?""></textarea></div>
  </div>
</div>

<script>
function switchTab(i){
  document.querySelectorAll('nav button').forEach((b,j)=>b.classList.toggle('active', j===i));
  document.querySelectorAll('.tab-content').forEach((p,j)=>p.classList.toggle('active', j===i));
  window.scrollTo({top:0, behavior:'smooth'});
}
function checkGap(btn){ const inp=btn.parentElement.querySelector('input'); if(!inp) return; const ans=(inp.dataset.answer||'').trim().toLowerCase(); const val=(inp.value||'').trim().toLowerCase(); inp.className = val ? (val===ans?'correct':'wrong') : ''; }
function checkSelect(el, correct){ el.className = el.value===correct ? 'correct' : (el.value!=='' ? 'wrong' : ''); }
(function(){
  var KEY='dow-vorb-sprechkarten';
  var store={}; try{store=JSON.parse(localStorage.getItem(KEY)||'{}');}catch(e){}
  var fields=[].slice.call(document.querySelectorAll('.notefield[data-save]'));
  fields.forEach(function(f){var k=f.getAttribute('data-save'); if(store[k]) f.value=store[k];});
  var timer;
  fields.forEach(function(f){f.addEventListener('input',function(){clearTimeout(timer);timer=setTimeout(function(){
    var o={}; fields.forEach(function(x){o[x.getAttribute('data-save')]=x.value;});
    try{localStorage.setItem(KEY,JSON.stringify(o));}catch(e){}
  },600);});});
})();
</script>
</body>
</html>
