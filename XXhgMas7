<!DOCTYPE html><html lang="de"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Grammatikfokus · Verben mit fester Präposition (A2–C1)</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--rot:#D42A21;--cream:#F6F9FA;--cream-warm:#F2F6FB;--paper:#FFFFFF;--ink:#20242B;--ink-soft:#4E5663;--ink-mute:#808B9B;--red:#D42A21;--red-soft:#FCE5E3;--teal:#1B9BC0;--teal-soft:#CFEEF7;--yellow:#FFD24A;--yellow-soft:#FFF1C2;--sand:#E3E8EF;--gelb:#E0A400;--blau:#2F72C9;--gruen:#2E9E5B;--accent:var(--blau);}
*{box-sizing:border-box;margin:0;padding:0;}html{scroll-behavior:smooth;}
body{background:linear-gradient(180deg,#E7F0FB 0%,var(--cream) 16%,var(--cream) 100%);color:var(--ink);font-family:'Inter',sans-serif;line-height:1.55;min-height:100vh;}
.wrapper{max-width:1080px;margin:0 auto;padding:2.2rem 1.6rem 5rem;}
.eyebrow{text-align:center;font-size:.78rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--blau);margin-bottom:.8rem;}
.title-wrap{text-align:center;margin-bottom:.2rem;}
h1.title{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:clamp(1.9rem,4.6vw,3.2rem);line-height:1.08;color:var(--ink);}
h1.title .hl{position:relative;display:inline-block;font-style:italic;padding:.05em .35em;}
h1.title .hl::before{content:'';position:absolute;inset:0;background:#BFDBFE;border-radius:12px;transform:rotate(-2deg);z-index:-1;}
.theme-line{font-family:'Space Grotesk';font-weight:700;font-size:clamp(1.3rem,3.4vw,2.1rem);color:var(--ink);text-align:center;margin-top:.5rem;}
.subtitle{text-align:center;max-width:680px;margin:.8rem auto 0;font-size:1.04rem;color:var(--ink-soft);}
.levelbar{display:flex;flex-direction:column;align-items:center;gap:.35rem;margin:1.3rem auto 0;}
.levelbar .lab{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mute);}
.levelsw{display:inline-flex;gap:.4rem;background:var(--paper);border:1.5px solid var(--sand);border-radius:999px;padding:.3rem;box-shadow:0 4px 14px rgba(32,36,43,.07);}
.levelsw button{font-family:'Inter';font-weight:700;font-size:.9rem;border:none;background:transparent;color:var(--ink);padding:.45rem 1rem;border-radius:999px;cursor:pointer;transition:.18s;}
.levelsw button:hover{background:var(--cream-warm);}
.levelsw button.on[data-l=einfach]{background:var(--gelb);color:#5a3d00;}
.levelsw button.on[data-l=komplexer]{background:var(--blau);color:#fff;}
.levelsw button.on[data-l=schwierig]{background:var(--gruen);color:#fff;}
.tabs{position:sticky;top:0;z-index:50;display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;background:rgba(231,240,251,.92);backdrop-filter:blur(8px);border-radius:999px;padding:.5rem;margin:1.4rem auto;max-width:fit-content;}
.tab{font-family:'Inter';font-size:.95rem;font-weight:600;border:2px solid transparent;background:var(--paper);color:var(--ink);padding:.55rem 1.05rem;border-radius:999px;cursor:pointer;transition:.15s;}
.tab:hover{border-color:var(--ink);transform:translateY(-1px);}
.tab.active{background:var(--blau);color:#fff;border-color:var(--blau);}
.section{display:none;animation:fade .35s ease;}
.section.active{display:block;}
@keyframes fade{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}
.lv{display:none;}
body[data-level=einfach] .lv[data-lvl=einfach],body[data-level=komplexer] .lv[data-lvl=komplexer],body[data-level=schwierig] .lv[data-lvl=schwierig]{display:block;}
.lvtag{display:inline-block;font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;border-radius:999px;padding:.12rem .55rem;margin-bottom:.6rem;}
.lv[data-lvl=einfach] .lvtag,.lvtag.e{background:var(--yellow-soft);color:#8a6400;}
.lv[data-lvl=komplexer] .lvtag,.lvtag.k{background:#E4EEFB;color:#1e4f91;}
.lv[data-lvl=schwierig] .lvtag,.lvtag.s{background:#E4F6EC;color:#1d6c3e;}
h2.section-title{font-family:'Space Grotesk';font-weight:700;font-size:clamp(1.5rem,3.2vw,2.2rem);text-align:center;color:var(--ink);margin:2rem 0 .5rem;}
.section-sub{text-align:center;color:var(--ink-soft);font-size:1rem;margin-bottom:1.3rem;}
.rulebox{background:var(--paper);border:2px solid var(--sand);border-left:6px solid var(--blau);border-radius:18px;padding:1.3rem 1.5rem;margin:1.1rem 0;box-shadow:0 4px 16px rgba(32,36,43,.05);}
.rulebox h3{font-family:'Space Grotesk';font-weight:700;color:var(--ink);font-size:1.12rem;margin-bottom:.5rem;display:flex;align-items:center;gap:.5rem;}
.rulebox p{margin:.45rem 0;color:var(--ink-soft);}
.rulebox .ex{font-family:'Space Grotesk';font-style:italic;color:var(--ink);}
.rulebox mark{background:var(--yellow-soft);padding:.03em .3em;border-radius:5px;font-weight:700;font-style:normal;font-family:'Inter';}
.tip{background:var(--yellow-soft);border:2px dashed var(--yellow);border-radius:16px;padding:1rem 1.3rem;font-size:.96rem;color:var(--ink);margin:1.1rem 0;line-height:1.7;}
.tip strong{color:var(--red);}
.tip.blue{background:#EAF2FD;border-color:var(--blau);}
table.gtab{width:100%;border-collapse:collapse;margin:1rem 0;font-size:.95rem;background:var(--paper);border-radius:12px;overflow:hidden;}
table.gtab th,table.gtab td{border:1px solid var(--sand);padding:.5rem .7rem;text-align:left;}
table.gtab th{background:#EAF2FD;color:var(--ink);font-family:'Space Grotesk';}
table.gtab td b{color:var(--blau);}
.heroimg{display:block;width:100%;max-width:640px;margin:0 auto 1.4rem;border-radius:18px;border:2px solid var(--sand);box-shadow:0 6px 22px rgba(32,36,43,.1);}
.exc .exi{width:100%;height:120px;object-fit:cover;border-radius:11px;margin-bottom:.6rem;border:1px solid var(--sand);background:#fff;}
.ex-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin:1.3rem 0;}
@media(max-width:720px){.ex-grid{grid-template-columns:1fr;}}
.exc{background:var(--paper);border:1.5px solid var(--sand);border-radius:16px;padding:1rem 1.15rem;border-left:5px solid var(--blau);box-shadow:0 3px 12px rgba(32,36,43,.05);}
.exc .vp{font-family:'Space Grotesk';font-weight:700;font-size:1.05rem;color:var(--blau);}
.exc .vp .case{font-family:'Inter';font-weight:600;font-size:.72rem;color:var(--ink-soft);background:var(--sand);padding:.08em .5em;border-radius:20px;margin-left:.3rem;vertical-align:middle;}
.exc .s1{font-style:italic;color:var(--ink);margin:.4rem 0;font-family:'Space Grotesk';line-height:1.45;}
.exc .note{font-size:.8rem;background:#FFF7E6;border:1px dashed var(--yellow);border-radius:9px;padding:.4rem .6rem;margin:.5rem 0;color:#7a5b00;font-style:normal;}
.exd{margin:.55rem 0 .2rem;border-top:1px solid var(--sand);padding-top:.5rem;}
.exd summary{cursor:pointer;font-family:'Space Grotesk';font-weight:700;font-size:.86rem;color:var(--blau);list-style:none;}
.exd summary::-webkit-details-marker{display:none;}
.exd summary::before{content:'\25B8 ';}
.exd[open] summary::before{content:'\25BE ';}
.exd .dlg{margin-top:.5rem;background:#F4F8FD;border-radius:10px;padding:.6rem .7rem;}
.exd .dlg p{margin:.25rem 0;font-size:.9rem;color:var(--ink);font-family:'Space Grotesk';}
.exd .dlg .sp{font-weight:700;color:var(--blau);margin-right:.2rem;}
.exc .s1 mark{background:var(--yellow-soft);padding:.03em .25em;border-radius:4px;font-style:normal;font-family:'Inter';font-weight:700;}
.exc .q{margin-top:.5rem;font-size:.86rem;background:var(--teal-soft);border-radius:9px;padding:.4rem .6rem;color:#0d6b85;font-weight:600;}
.flip{perspective:1000px;width:100%;max-width:460px;height:270px;margin:1.3rem auto;cursor:pointer;}
.flip-inner{position:relative;width:100%;height:100%;transition:transform .6s;transform-style:preserve-3d;}
.flip.flipped .flip-inner{transform:rotateY(180deg);}
.flip-side{position:absolute;inset:0;backface-visibility:hidden;background:var(--paper);border:2px solid var(--sand);border-radius:22px;padding:1.8rem;display:flex;flex-direction:column;justify-content:center;text-align:center;box-shadow:0 8px 24px rgba(32,36,43,.08);}
.flip-side.back{transform:rotateY(180deg);background:linear-gradient(135deg,#EAF2FD,#F6F9FA);border-color:var(--blau);}
.flip-word{font-family:'Space Grotesk';font-weight:700;font-size:1.5rem;color:var(--ink);}
.flip-prompt{font-size:.82rem;color:var(--ink-mute);font-style:italic;margin-top:.5rem;}
.flip-da{color:var(--blau);font-weight:800;font-size:1.6rem;}
.flip-wo{color:var(--gruen);font-weight:700;margin-top:.3rem;}
.flip-ex{font-family:'Space Grotesk';font-style:italic;color:var(--ink);margin-top:.5rem;font-size:.95rem;}
.lk-nav{display:flex;align-items:center;justify-content:center;gap:1rem;margin-top:.8rem;}
.lk-btn{font-size:1.3rem;background:var(--paper);border:2px solid var(--ink);width:42px;height:42px;border-radius:50%;cursor:pointer;color:var(--ink);}
.lk-btn:hover{background:var(--ink);color:#fff;}
.lk-counter{font-family:'Space Grotesk';font-weight:600;}
.exblock{background:var(--paper);border:2px solid var(--sand);border-radius:16px;padding:1.2rem 1.35rem;margin:1rem 0;}
.exblock h3{font-family:'Space Grotesk';font-weight:700;color:var(--ink);font-size:1.1rem;margin-bottom:.3rem;}
.exhow{font-size:.85rem;color:var(--ink-mute);margin-bottom:.8rem;}
.gap-line{padding:.5rem 0;border-bottom:1px dashed var(--sand);font-family:'Space Grotesk';font-size:1rem;line-height:1.8;}
.gap-line:last-of-type{border-bottom:0;}
.ex-gap select{font-family:'Inter';font-size:.9rem;font-weight:600;color:var(--blau);background:var(--cream-warm);border:1.5px solid var(--sand);border-radius:8px;padding:.18rem .45rem;margin:0 .2em;cursor:pointer;}
.ex-gap select.right{background:#E4F6EC;color:var(--gruen);border-color:var(--gruen);}
.ex-gap select.wrong{background:var(--red-soft);color:var(--red);border-color:var(--red);}
.ex-actions{display:flex;gap:.6rem;justify-content:flex-end;margin-top:.8rem;}

.speak-img{width:120px;height:120px;object-fit:cover;border-radius:16px;border:2px solid var(--sand);margin:0 auto .8rem;display:block;}
.ch-level{display:inline-block;font-family:'Space Grotesk';font-weight:700;font-size:.8rem;color:#fff;background:var(--blau);padding:.2rem .8rem;border-radius:999px;margin-bottom:.4rem;}
.ch-level.einfach{background:var(--gelb);color:#5a3d00;}
.ch-level.komplexer{background:var(--blau);color:#fff;}
.ch-level.schwierig{background:var(--gruen);color:#fff;}
.ch-help{list-style:none;max-width:360px;margin:.3rem auto 1rem;text-align:left;padding:0;}
.ch-help li{background:#fff;border:1px solid var(--sand);border-left:4px solid var(--gruen);border-radius:9px;padding:.4rem .7rem;margin:.35rem 0;font-size:.9rem;color:var(--ink);font-family:'Space Grotesk';}
.challenge{text-align:center;background:linear-gradient(135deg,#EAF2FD,#F0FBF4);border:2px solid var(--blau);margin-top:1.6rem;}
.ch-img{width:120px;height:120px;object-fit:cover;border-radius:16px;border:2px solid var(--sand);margin:.6rem auto;}
.ch-topic{font-family:'Space Grotesk';font-weight:800;font-size:1.25rem;color:var(--ink);margin:.8rem 0;min-height:1.4em;}
.ch-timer{font-family:'Space Grotesk';font-weight:800;font-size:3rem;color:var(--blau);margin:.3rem 0 1rem;letter-spacing:.04em;}
.ch-timer.run{color:var(--gruen);}
.ch-timer.done{color:var(--rot);}
.ch-hint{font-size:.82rem;color:var(--ink-soft);margin:-.4rem 0 1rem;font-family:'Space Grotesk';}
.ch-timer{cursor:pointer;}
.quiz-img{width:70px;height:70px;object-fit:cover;border-radius:11px;border:1.5px solid var(--sand);float:left;margin:0 .7rem .2rem 0;background:#fff;}
.quiz-q{overflow:hidden;}
.game{max-width:480px;margin:1rem auto 0;}
.game-hud{display:flex;justify-content:space-between;gap:.5rem;font-family:'Space Grotesk';font-size:.9rem;color:var(--ink-soft);margin-bottom:.5rem;flex-wrap:wrap;}
.game-hud b{color:var(--ink);}
.game-bar{height:9px;background:var(--sand);border-radius:99px;overflow:hidden;margin-bottom:1rem;}
.game-bar-fill{height:100%;width:0%;background:linear-gradient(90deg,var(--blau),var(--gruen));border-radius:99px;transition:width .35s;}
.gcard{perspective:1200px;width:100%;height:290px;margin:0 auto 1.1rem;}
.gcard-inner{position:relative;width:100%;height:100%;transition:transform .55s;transform-style:preserve-3d;}
.gcard.flipped .gcard-inner{transform:rotateY(180deg);}
.gcard-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:24px;padding:1.6rem;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;box-shadow:0 10px 30px rgba(32,36,43,.1);}
.gcard-front{background:var(--paper);border:2.5px solid var(--blau);}
.gcard-back{background:linear-gradient(135deg,#EAF2FD,#F0FBF4);border:2.5px solid var(--gruen);transform:rotateY(180deg);}
.glabel{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);font-weight:700;margin-bottom:.7rem;}
.gverb{font-family:'Space Grotesk';font-weight:800;font-size:2rem;color:var(--ink);line-height:1.15;}
.gtask{margin-top:1rem;font-size:.92rem;color:var(--blau);font-weight:700;font-family:'Space Grotesk';}
.gda{font-family:'Space Grotesk';font-weight:800;font-size:2.4rem;color:var(--blau);}
.gwo{font-weight:700;color:var(--gruen);font-size:1.15rem;margin-top:.3rem;}
.gex{font-family:'Space Grotesk';font-style:italic;color:var(--ink);margin-top:.7rem;font-size:1.05rem;}
.gfrage{margin-top:.8rem;font-size:1.2rem;font-weight:600;color:var(--ink);line-height:1.4;}
.gantwort{font-family:'Space Grotesk';font-weight:700;font-size:1.3rem;color:var(--ink);line-height:1.35;}
.ghinweis{margin-top:.9rem;display:inline-block;font-size:.85rem;font-weight:700;color:var(--blau);background:#E9F1FB;padding:.3rem .8rem;border-radius:999px;}
.game-ctrl{text-align:center;display:flex;gap:.7rem;justify-content:center;flex-wrap:wrap;}
.btn-ok{background:var(--gruen);color:#fff;border:2px solid var(--gruen);font-weight:700;padding:.55rem 1.3rem;border-radius:999px;cursor:pointer;font-size:.98rem;}
.btn-no{background:#fff;color:var(--rot);border:2px solid var(--rot);font-weight:700;padding:.55rem 1.3rem;border-radius:999px;cursor:pointer;font-size:.98rem;}
.btn-ok:hover{filter:brightness(.95);}.btn-no:hover{background:#FDECEA;}
.gend{text-align:center;padding:1.5rem;background:linear-gradient(135deg,#FFF7E6,#F0FBF4);border:2px solid var(--yellow);border-radius:20px;}
.gend-emoji{font-size:2.6rem;}
.gend-title{font-family:'Space Grotesk';font-weight:800;font-size:1.3rem;color:var(--ink);margin:.4rem 0;}
.gend-score{color:var(--ink-soft);margin-bottom:1rem;font-size:1rem;}
.gcard.shake{animation:gshake .4s;}
@keyframes gshake{0%,100%{transform:translateX(0);}25%{transform:translateX(-7px);}75%{transform:translateX(7px);}}
.btn-primary{background:var(--blau);color:#fff;border:2px solid var(--blau);font-weight:700;padding:.5rem 1.3rem;border-radius:999px;cursor:pointer;font-size:.95rem;}
.btn-primary:hover{filter:brightness(.95);}
.btn-secondary{background:var(--paper);color:var(--ink);border:2px solid var(--ink);font-weight:600;padding:.5rem 1.3rem;border-radius:999px;cursor:pointer;font-size:.95rem;}
.gap-score{margin-top:.7rem;font-size:.9rem;background:var(--yellow-soft);border-radius:10px;padding:.5rem .8rem;display:none;}
.gap-score.show{display:block;}
.quiz{background:var(--cream-warm);border:1.5px solid var(--sand);border-radius:14px;padding:1rem 1.2rem;margin:.8rem 0;}
.quiz-q{font-family:'Space Grotesk';font-size:1rem;color:var(--ink);margin-bottom:.7rem;}
.quiz-opts{display:flex;flex-wrap:wrap;gap:.45rem;}
.quiz-chip{background:var(--paper);border:2px solid var(--sand);font-weight:600;font-size:.95rem;color:var(--ink);padding:.4rem 1rem;border-radius:999px;cursor:pointer;}
.quiz-chip:hover{border-color:var(--ink);}
.quiz-chip.correct{background:#E4F6EC;border-color:var(--gruen);color:var(--gruen);}
.quiz-chip.wrong{background:var(--red-soft);border-color:var(--red);color:var(--red);text-decoration:line-through;}
.quiz-explain{margin-top:.6rem;font-size:.86rem;color:var(--gruen);background:#E4F6EC;padding:.5rem .8rem;border-radius:10px;display:none;}
.quiz-explain.show{display:block;}
.match-cols{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
@media(max-width:600px){.match-cols{grid-template-columns:1fr;}}
.match-col h4{font-family:'Space Grotesk';font-weight:700;text-align:center;margin-bottom:.6rem;}
.match-list{display:flex;flex-direction:column;gap:.45rem;}
.match-item{background:var(--paper);border:2px solid var(--sand);border-radius:12px;padding:.6rem .9rem;cursor:pointer;font-weight:600;font-size:.9rem;text-align:center;}
.match-item:hover{border-color:var(--ink);}
.match-item.selected{background:var(--yellow-soft);border-color:var(--yellow);}
.match-item.done{background:#E4F6EC;border-color:var(--gruen);color:var(--gruen);pointer-events:none;}
.match-item.wrong{background:var(--red-soft)!important;border-color:var(--red)!important;animation:shake .4s;}
@keyframes shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-5px);}75%{transform:translateX(5px);}}
.speak-card{background:linear-gradient(135deg,var(--paper),var(--cream-warm));border:2px solid var(--sand);border-radius:20px;padding:1.6rem;text-align:center;min-height:150px;display:flex;flex-direction:column;justify-content:center;margin:1rem auto;max-width:600px;}
.speak-q{font-family:'Space Grotesk';font-size:1.15rem;font-style:italic;color:var(--ink);}
.speak-hint{font-size:.84rem;color:var(--ink-soft);margin-top:.5rem;font-style:italic;}
.debate-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;margin:1rem 0;}
@media(max-width:600px){.debate-grid{grid-template-columns:1fr;}}
.debate{background:var(--paper);border:1.5px solid var(--sand);border-radius:14px;padding:.9rem 1.1rem;border-left:5px solid var(--blau);}
.debate-num{font-size:.7rem;font-weight:700;color:var(--blau);letter-spacing:.08em;text-transform:uppercase;}
.debate-q{font-family:'Space Grotesk';font-weight:700;font-style:italic;color:var(--ink);font-size:.97rem;margin-top:.3rem;}
footer{text-align:center;color:var(--ink-mute);font-size:.85rem;padding:3rem 1rem 1.5rem;margin-top:2.5rem;}
footer strong{color:var(--ink);}

/* ====== Farb-Boost & Markierungen ====== */
.s1 mark,.dlg mark,.exhow mark{background:#E3EEFC;color:#1F5BB0;font-weight:800;padding:.06em .42em;border-radius:7px;font-style:normal;font-family:'Inter';box-shadow:inset 0 -2px 0 rgba(47,114,201,.25);}
.rulebox mark{background:#FFE89C;color:#7a5b00;box-shadow:inset 0 -2px 0 rgba(224,164,0,.35);}
/* Niveau-Farbcodierung der Karten */
.lv[data-lvl=einfach] .exc,.lv[data-lvl=einfach] .quiz{border-left:5px solid var(--gelb);}
.lv[data-lvl=komplexer] .exc,.lv[data-lvl=komplexer] .quiz{border-left:5px solid var(--blau);}
.lv[data-lvl=schwierig] .exc,.lv[data-lvl=schwierig] .quiz{border-left:5px solid var(--gruen);}
.quiz{border-left:5px solid var(--sand);padding-left:.85rem;border-radius:4px;}
/* leicht getönte Niveau-Flächen */
.lv{border-radius:14px;padding:.7rem .7rem .3rem;margin-bottom:.4rem;}
.lv[data-lvl=einfach]{background:linear-gradient(180deg,#FFFBF0,#ffffff);}
.lv[data-lvl=komplexer]{background:linear-gradient(180deg,#F4F9FF,#ffffff);}
.lv[data-lvl=schwierig]{background:linear-gradient(180deg,#F3FCF7,#ffffff);}
/* farbige Block-Überschriften */
.exblock h3{border-left:6px solid var(--blau);padding-left:.6rem;border-radius:2px;}
/* farbige Verb-Köpfe + Kasus-Tags nach Niveau */
.lv[data-lvl=einfach] .exc .vp{color:#B07700;}
.lv[data-lvl=schwierig] .exc .vp{color:#1b6b3c;}
.lv[data-lvl=einfach] .case{background:#FDF0CE;color:#8a6a00;}
.lv[data-lvl=schwierig] .case{background:#DFF3E7;color:#1b6b3c;}
/* lebendigere Chips & Buttons */
.quiz-chip{transition:.15s;}
.quiz-chip:hover{background:#E3EEFC;border-color:var(--blau);}
/* Schlüsselform im Spiel hervorheben */
.gda{text-shadow:0 2px 0 rgba(47,114,201,.12);}
/* Mini-Dialog-Sprecher farblich trennen */
.exd .dlg p:nth-child(even) .sp{color:var(--gruen);}


/* ====== Motion & Politur ====== */
@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:none;}}
.section.active>*{animation:fadeUp .5s cubic-bezier(.22,.61,.36,1) both;}
.section.active>*:nth-child(1){animation-delay:.00s}.section.active>*:nth-child(2){animation-delay:.05s}.section.active>*:nth-child(3){animation-delay:.10s}.section.active>*:nth-child(4){animation-delay:.15s}.section.active>*:nth-child(5){animation-delay:.20s}.section.active>*:nth-child(6){animation-delay:.25s}.section.active>*:nth-child(n+7){animation-delay:.30s}
/* sanfte Hover-Hebung */
.exc,.rulebox,.debate,.gtab{transition:transform .2s cubic-bezier(.22,.61,.36,1),box-shadow .2s;}
.exc:hover,.rulebox:hover{transform:translateY(-4px);box-shadow:0 14px 32px rgba(32,36,43,.13);}
.exc .exi{transition:transform .35s;}
.exc:hover .exi{transform:scale(1.04);}
/* Buttons mit Mikro-Interaktion */
.btn-primary,.btn-ok,.btn-no,.btn-secondary{transition:transform .12s,filter .15s,box-shadow .18s;}
.btn-primary:hover{box-shadow:0 7px 20px rgba(47,114,201,.33);}
.btn-ok:hover{box-shadow:0 7px 20px rgba(46,158,91,.33);}
.btn-primary:active,.btn-ok:active,.btn-no:active,.btn-secondary:active{transform:scale(.95);}
/* Tabs */
.tab{transition:background .18s,color .18s,transform .12s;}
.tab:active{transform:scale(.96);}
/* Niveau-Buttons */
.levelsw button{transition:background .2s,color .2s,transform .12s;}
.levelsw button:active{transform:scale(.95);}
/* Timer-Puls & Fortschritts-Schimmer */
.ch-timer.run{animation:pulse 1.1s ease-in-out infinite;}
@keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.06);}}
.game-bar-fill{background:linear-gradient(90deg,var(--blau),var(--gruen));background-size:220% 100%;animation:shimmer 2.4s linear infinite;}
@keyframes shimmer{to{background-position:220% 0;}}
/* Hero sanftes Schweben + Tricolor-Akzent */
.heroimg{animation:floaty 6.5s ease-in-out infinite;}
@keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-6px);}}
.wrapper::before{content:'';display:block;height:5px;max-width:120px;margin:0 auto 1.3rem;border-radius:99px;background:linear-gradient(90deg,var(--gelb),var(--blau),var(--gruen));}
/* Chips & Lernkarten-Spiel Einblendung */
.quiz-chip{transition:background .15s,border-color .15s,transform .1s;}
.quiz-chip:active{transform:scale(.95);}
.gcard{animation:fadeUp .45s both;}
.gend{animation:popin .5s cubic-bezier(.34,1.56,.64,1) both;}
@keyframes popin{from{opacity:0;transform:scale(.8);}to{opacity:1;transform:scale(1);}}
/* Konfetti */
.cfti{position:fixed;top:-12px;width:9px;height:15px;border-radius:2px;z-index:9999;pointer-events:none;animation:cfall 2.5s linear forwards;}
@keyframes cfall{to{transform:translateY(108vh) rotate(760deg);opacity:.15;}}
/* Barrierefrei: Bewegung reduzieren */
@media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important;}}


/* ====== Schwebende Bildchen ====== */
@keyframes floatsm{0%,100%{transform:translateY(0);}50%{transform:translateY(-6px);}}
.exi,.quiz-img,.speak-img,.ch-img,.rule-ic,.blk-ic{animation:floatsm 4.6s ease-in-out infinite;will-change:transform;}
.exc:nth-child(3n) .exi{animation-duration:5.4s;animation-delay:.6s;}
.exc:nth-child(3n+1) .exi{animation-duration:4.7s;animation-delay:.2s;}
.exc:nth-child(3n+2) .exi{animation-duration:5.9s;animation-delay:1s;}
.quiz:nth-child(odd) .quiz-img{animation-delay:.3s;animation-duration:5.1s;}
.quiz:nth-child(even) .quiz-img{animation-delay:.9s;animation-duration:4.9s;}
.rule-ic{width:54px;height:54px;object-fit:cover;border-radius:13px;float:right;margin:0 0 .4rem .7rem;border:1.5px solid var(--sand);box-shadow:0 4px 12px rgba(32,36,43,.1);}
.rule-ic{animation-delay:.4s;}
.blk-ic{width:46px;height:46px;object-fit:cover;border-radius:11px;float:right;margin:0 0 .3rem .6rem;border:1.5px solid var(--sand);box-shadow:0 3px 10px rgba(32,36,43,.09);}
.exblock h3{overflow:hidden;}


.merk-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.9rem;margin:.6rem 0 .4rem;}
.merkbox{position:relative;background:var(--paper);border:1.5px solid var(--sand);border-left:5px solid var(--blau);border-radius:16px;padding:1.05rem 1.1rem .95rem 1.1rem;box-shadow:0 3px 12px rgba(32,36,43,.05);}
