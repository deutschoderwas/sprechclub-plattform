var $=function(id){return document.getElementById(id);};
var runde=-1,nr=0,punkte=0,offen=false,fertig={};
function rounds(){return QD[curLevel]||QD.komplexer;}
function rebuild(){
  fertig[curLevel]=fertig[curLevel]||[];
  var g=$('kqRunden');if(!g)return;g.innerHTML='';
  rounds().forEach(function(R,i){
    var b=document.createElement('button');b.className='kqr';b.dataset.i=i;
    b.innerHTML='<div class="kqr-i">'+R.i+'</div><div class="kqr-t">'+R.t+'</div><div class="kqr-d">'+R.d+' · '+R.q.length+' Fragen</div>';
    b.addEventListener('click',function(){rundeStart(i);});
    g.appendChild(b);
  });
  rundeStart(0);
}
function rundeStart(i){
  runde=i;nr=0;punkte=0;offen=false;
  var done=fertig[curLevel]||[];
  document.querySelectorAll('#kqRunden .kqr').forEach(function(b){
    b.classList.toggle('active',+b.dataset.i===i);
    b.classList.toggle('fertig',done.indexOf(+b.dataset.i)>=0 && +b.dataset.i!==i);
  });
  $('kqEnde').style.display='none';$('kqInhalt').style.display='block';
  frage();
}
function frage(){
  var R=rounds()[runde];if(!R)return;
  if(nr>=R.q.length){ende();return;}
  var f=R.q[nr];offen=true;
  $('kqZaehler').textContent='Runde '+(runde+1)+' · '+R.t+' · Frage '+(nr+1)+'/'+R.q.length;
  $('kqPunkte').textContent=punkte+' von '+R.q.length;
  $('kqBalken').style.width=(nr/R.q.length*100)+'%';
  $('kqFrage').innerHTML=f.f;
  var paare=f.o.map(function(t,j){return{t:t,ok:j===f.r};});
  for(var j=paare.length-1;j>0;j--){var k=Math.floor(Math.random()*(j+1));var h=paare[j];paare[j]=paare[k];paare[k]=h;}
  var buch='ABCD',opts=$('kqOpts');opts.innerHTML='';
  paare.forEach(function(p,j){
    var b=document.createElement('button');b.className='kqo';b.dataset.ok=p.ok?'1':'0';
    b.innerHTML='<span class="kqo-b">'+buch[j]+'</span><span>'+p.t+'</span>';
    b.addEventListener('click',function(){antwort(b,f);});
    opts.appendChild(b);
  });
  var e=$('kqErkl');e.className='kq-erkl';e.innerHTML='';
}
function antwort(btn,f){
  if(!offen)return;offen=false;
  var ok=btn.dataset.ok==='1';
  document.querySelectorAll('#kqOpts .kqo').forEach(function(b){b.classList.add('aus');if(b.dataset.ok==='1')b.classList.add('richtig');});
  if(!ok)btn.classList.add('falsch');
  if(ok)punkte++;
  $('kqPunkte').textContent=punkte+' von '+rounds()[runde].q.length;
  var e=$('kqErkl');e.innerHTML=(ok?'✅ <b>Richtig.</b> ':'❌ <b>Nicht ganz.</b> ')+f.e;e.className='kq-erkl an';
}
function weiter(){
  if(offen){var b=$('kqOpts').querySelector('.kqo[data-ok="1"]');if(b){antwort(b,rounds()[runde].q[nr]);punkte--;$('kqPunkte').textContent=punkte+' von '+rounds()[runde].q.length;return;}}
  nr++;frage();
}
function ende(){
  var R=rounds()[runde],n=R.q.length;var done=fertig[curLevel]||(fertig[curLevel]=[]);
  if(done.indexOf(runde)<0)done.push(runde);
  document.querySelectorAll('#kqRunden .kqr').forEach(function(b){b.classList.toggle('fertig',done.indexOf(+b.dataset.i)>=0);});
  $('kqBalken').style.width='100%';$('kqInhalt').style.display='none';
  var lob=punkte===n?'Alles richtig — perfekt! 🎉':(punkte>=n-1?'Fast alles — stark!':(punkte>=n/2?'Gut gemacht. Schau dir die Erklärungen nochmal an.':'Diese Runde nochmal — beim zweiten Mal sitzt es.'));
  var naechste=(runde+1)%rounds().length;
  $('kqEnde').style.display='block';
  $('kqEnde').innerHTML='<div class="gross">'+punkte+'/'+n+'</div><p>'+lob+'</p><div class="kq-ctrls"><button class="btn-secondary" id="kqNochmal">↺ Diese Runde nochmal</button><button class="btn-primary" id="kqNext">'+rounds()[naechste].i+' Weiter: '+rounds()[naechste].t+' →</button></div>';
  $('kqNochmal').addEventListener('click',function(){rundeStart(runde);});
  $('kqNext').addEventListener('click',function(){rundeStart(naechste);});
}
var _neu=$('kqNeu');if(_neu)_neu.addEventListener('click',function(){rundeStart(runde);});
var _w=$('kqWeiter');if(_w)_w.addEventListener('click',weiter);
