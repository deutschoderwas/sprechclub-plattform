{
  "rewrites": [
    {
      "source": "/preise",
      "destination": "/preise.html"
    },
    {
      "source": "/lehrkraft-werden",
      "destination": "/lehrkraft-werden.html"
    },
    {
      "source": "/niveau-test",
      "destination": "/niveau-test.html"
    },
    {
      "source": "/schuelerbereich",
      "destination": "/konto.html"
    },
    {
      "source": "/sprechclub",
      "destination": "/sprechclub.html"
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
