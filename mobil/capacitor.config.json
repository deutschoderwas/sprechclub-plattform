{
  "appId": "de.deutschoderwas.club",
  "appName": "deutschoderwas",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "www.deutschoderwas-club.de",
      "deutschoderwas-club.de",
      "*.supabase.co",
      "unpkg.com",
      "cdn.jsdelivr.net",
      "fonts.googleapis.com",
      "fonts.gstatic.com",
      "*.elevenlabs.io"
    ]
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#FBF9F5",
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#FBF9F5",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#FBF9F5",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#D83636"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FBF9F5"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
